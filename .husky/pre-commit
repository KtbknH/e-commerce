echo "🔍 Pre-commit: Vérification du code..."

BACKEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.java$')
FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^frontend/.*\.\(js\|jsx\|ts\|tsx\)$')


if [ -n "$BACKEND_FILES" ]; then
    echo ""
    echo "☕ Backend Java..."
    cd backend
    mvn spotless:check -q 2>/dev/null || { echo "❌ Formatage ! → cd backend && mvn spotless:apply"; exit 1; }
    mvn compile -q -DskipTests 2>/dev/null || { echo "❌ Compilation !"; exit 1; }
    echo "✅ Backend OK"
    cd ..
fi

if [ -n "$FRONTEND_FILES" ]; then
    echo ""
    echo "⚛️  Frontend React Native..."
    cd frontend
    npx eslint --max-warnings=0 $(echo "$FRONTEND_FILES" | sed 's|^frontend/||') 2>/dev/null || { echo "❌ ESLint !"; exit 1; }
    echo "✅ Frontend OK"
    cd ..
fi

if [ -z "$BACKEND_FILES" ] && [ -z "$FRONTEND_FILES" ]; then
    echo "✅ Skip (pas de .java/.js/.tsx modifié)"
fi

echo ""
echo "✅ Pre-commit terminé"
